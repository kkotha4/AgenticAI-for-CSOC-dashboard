# Copy to .env, fill in, and keep it private. .env is ignored by git.
DOMAIN=soc.example.com

# Model provider. Leave blank for demo mode only. claude_code isn't allowed in production.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# For the optional simulated alert stream
ALERT_EVERY_SECONDS=120
